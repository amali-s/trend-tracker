# Copy to .env and fill in. .env is gitignored — never commit real values.

# Claude, for the classifier gate and the extraction pass.
ANTHROPIC_API_KEY=sk-ant-...

# Where the digest is sent. Nothing is hardcoded anywhere in the source —
# this variable is the only place the recipient is configured.
EMAIL_TO=your.email@example.com

# --- Delivery: pick ONE provider ---

# Option A — Gmail SMTP. GMAIL_APP_PASSWORD is a Google App Password
# (16 characters, requires 2FA on the account), not your account password.
GMAIL_USER=your.email@example.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Option B — SendGrid. EMAIL_FROM must be a verified sender.
# SENDGRID_API_KEY=SG....
# EMAIL_FROM=digest@yourdomain.com
